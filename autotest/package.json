{
  "name": "mediakraken-autotest",
  "version": "1.0.0",
  "description": "Playwright-based tests for MediaKraken",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test e2e",
    "test:integration": "playwright test integration",
    "test:unit": "playwright test unit",
    "test:headed": "playwright test --headed",
