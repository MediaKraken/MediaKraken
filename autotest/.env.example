# MediaKraken Autotest Environment
# Copy this file to .env and fill in the values. All variables are
# optional: tests that need a missing value skip themselves, so the suite
# is green out of the box against the live deployment.

# URL of the MediaKraken instance under test. Only the origin
# (scheme://host[:port]) matters; it is used for baseURL and as the
# CSRF Origin/Referer value.
BASE_URL=https://mk.mediakraken.media

# Regular user for the authenticated tests. Must have the User::View
# permission (GET /user/home must render, not 401 — freshly registered
# accounts start with NO permissions and will fail the fixture).
# Without these, all authPage/authRequest tests skip.
#TEST_USERNAME=
#TEST_PASSWORD=
# 2FA (Authy) token source — only needed when the account has 2FA enabled.
# Note: the tests submit a static token; Authy TOTP one-time codes need a
# live token generator instead.
#TEST_AUTHY_TOKEN=

# Admin user for the admin tests. Must have the Admin::View permission.
# Without these, all adminPage/adminRequest tests skip.
#ADMIN_USERNAME=
#ADMIN_PASSWORD=
#ADMIN_AUTHY_TOKEN=

# Set to 1 to enable the registration SUCCESS tests. They insert REAL USER
# ROWS on the target deployment (use MK_TEST_RUN_ID below for deterministic
# usernames). Leave unset in CI against production.
#MK_TEST_ALLOW_REGISTER=

# Optional: deterministic run id used as the username suffix for
# registration tests (e.g. a CI run id). Unset = random 6-char suffix.
#MK_TEST_RUN_ID=
